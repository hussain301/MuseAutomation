{
  "manifest_version": 3,
  "name": "Muse Agent Orchestrator",
  "version": "1.0.5",
  "description": "Connects this browser's Muse AI agent to the central Orchestrator server for coordinated messaging.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://*.muse.ai/*",
    "*://muse.ai/*",
    "http://*/*",
    "https://*/*",
    "ws://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Muse Orchestrator"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.muse.ai/*",
        "*://muse.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
